{
  "name": "hanabi-client",
  "version": "0.1.0-alpha",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:w": "ng test --watch",
    "prebuild:ghp": "scripts/gen.sh",
    "build:ghp": "ng build --base-href https://inkassso.github.io/hanabi/",
    "build:gp": "ng build --base-href https://inkassso.github.io/hanabi/",
    "deploy": "npx angular-cli-ghpages --dir=dist/hanabi-client"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/reenie-beanie": "^4.5.8",
    "@forevolve/bootstrap-dark": "^2.1.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.1.3",
    "ngx-bootstrap-icons": "^1.8.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
